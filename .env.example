# Google OAuth 2.0 Web Client ID
CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Cloudflare Worker Google OAuth Refresh Proxy URL
# - 로컬 개발/테스트 시 (wrangler dev): http://localhost:8787
# - 프로덕션 배포 시: https://your-worker-name.your-subdomain.workers.dev
VITE_GOOGLE_AUTH_WORKER_URL=http://localhost:8787


# 사이트 도메인 및 Base URL (선택)
VITE_SITE_URL=https://your-site-domain.com
VITE_BASE_URL=/